          "target": "~/public/hermez/hermez-symbol.svg"
        },
        {
          "path": "public/hermez/hermez-symbol-dark.svg",
          "type": "registry:file",
          "target": "~/public/hermez/hermez-symbol-dark.svg"
        }
      ]
    },
