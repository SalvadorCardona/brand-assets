{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "hermez",
  "homepage": "https://salvadorcardona.github.io/brand-assets/",
  "items": [
    {
      "name": "hermez",
      "type": "registry:style",
      "title": "Hermez",
      "description": "Le style Hermez : thème, polices (Bricolage Grotesque, Outfit) et règles de base (corps, titres). À installer en premier.",
      "registryDependencies": [
        "hermez-theme",
        "cn"
      ]
    },
    {
      "name": "hermez-theme",
      "type": "registry:theme",
      "title": "Thème Hermez",
      "description": "Les tokens : couleurs sémantiques, palette de données, couleurs du logo, typographie, rayons, ombres et mouvement."
    },
    {
      "name": "hermez-logo",
      "type": "registry:component",
      "title": "Logo Hermez",
      "description": "Le symbole Hermez en composant React (HermezMark) et les fichiers SVG du logo, copiés dans public/hermez/.",
      "registryDependencies": [
        "hermez-theme"
      ],
      "files": [
        {
          "path": "src/identity/hermez-mark.tsx",
          "type": "registry:component"
        },
        {
          "path": "public/hermez/hermez-logo.svg",
          "type": "registry:file",
          "target": "~/public/hermez/hermez-logo.svg"
        },
        {
          "path": "public/hermez/hermez-logo-dark.svg",
          "type": "registry:file",
          "target": "~/public/hermez/hermez-logo-dark.svg"
        },
        {
          "path": "public/hermez/hermez-symbol.svg",
